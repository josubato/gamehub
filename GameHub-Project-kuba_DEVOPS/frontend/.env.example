# Copy to .env.production (or .env.local) and adjust.

# Full API base URL used by the built app (e.g. on Firebase Hosting).
# Leave empty in local development - Vite proxies /api to VITE_PROXY_TARGET.
VITE_API_URL=https://YOUR_PROJECT_ID.appspot.com/api

# Dev-server proxy target (defaults to the local Flask backend).
VITE_PROXY_TARGET=http://localhost:8080
